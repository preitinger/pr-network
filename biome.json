{
    "$schema": "https://biomejs.dev/schemas/2.4.0/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "app/**",
            "!app/_lib/splitter",
            "!app/de/splitter",
            "!app/en/splitter",
            "!app/_lib/mySw/00-old",
            "!app/de/_splitter"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf"
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "a11y": {
                "useValidAnchor": "off"
            },
            "style": {
                "useTemplate": "off",
                "useNodejsImportProtocol": "off"
            },
            "complexity": {
                "noUselessFragments": "off"
            },
            "suspicious": {
                "noDoubleEquals": "off",
                "noImplicitAnyLet": "off",
                "noArrayIndexKey": "off",
                "noAssignInExpressions": "off",
                "noThenProperty": "off"
            },
            "correctness": {
                "useParseIntRadix": "off",
                "noConstantCondition": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "off"
            }
        }
    }
}
